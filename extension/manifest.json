{
  "manifest_version": 3,
  "name": "IDPS Shield",
  "version": "1.0.0",
  "description": "AI-Powered Intelligent Cyber Defense System Browser Extension",
  "permissions": [
    "activeTab",
    "storage",
    "webNavigation"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}